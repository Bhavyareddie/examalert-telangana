# ============================================
# ExamAlert Telangana — Backend Environment
# NEVER commit the actual .env file to Git
# ============================================

NODE_ENV=development
PORT=5000

# ── Supabase ──────────────────────────────
# Get from: supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
# WARNING: SUPABASE_SERVICE_KEY bypasses RLS — never expose to frontend

# ── Google Gemini AI ──────────────────────
# Get from: makersuite.google.com/app/apikey (free)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Security ──────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_a_random_64_char_hex_string_here

# ── CORS ──────────────────────────────────
# Your frontend URL — no trailing slash
FRONTEND_URL=http://localhost:3000

# ── Email (Gmail SMTP) ────────────────────
# Use Gmail App Password (not your main password)
# Enable at: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=ExamAlert Telangana <noreply@examalert.in>

# ── Production only ───────────────────────
# NODE_ENV=production
# FRONTEND_URL=https://your-app.vercel.app
